{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth_route": {
        "ClusterId": "auth_cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "restaurant_route": {
        "ClusterId": "restaurant_cluster",
        "Match": {
          "Path": "/api/restaurants/{**catch-all}"
        }
      },
      "order_route": {
        "ClusterId": "order_cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "delivery_route": {
        "ClusterId": "delivery_cluster",
        "Match": {
          "Path": "/api/deliveries/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth_cluster": {
        "Destinations": {
          "auth_destination": {
            "Address": "http://localhost:5262"
          }
        }
      },
      "restaurant_cluster": {
        "Destinations": {
          "restaurant_destination": {
            "Address": "http://localhost:5265"
          }
        }
      },
      "order_cluster": {
        "Destinations": {
          "order_destination": {
            "Address": "http://localhost:5223"
          }
        }
      },
      "delivery_cluster": {
        "Destinations": {
          "delivery_destination": {
            "Address": "http://localhost:5085"
          }
        }
      }
    }
  }
}
