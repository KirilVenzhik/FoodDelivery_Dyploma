{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "food-delivery",
    "Audience": "food-delivery",
    "SecretKey": "SUPER_SECRET_DEVELOPMENT_KEY_123456789",
    "ExpirationMinutes": 60
  },
  "ReverseProxy": {
    "Routes": {
      "auth_route": {
        "ClusterId": "auth_cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "restaurant_route": {
        "ClusterId": "restaurant_cluster",
        "Match": { "Path": "/api/restaurants/{**catch-all}" }
      },
      "order_route": {
        "ClusterId": "order_cluster",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payment_route": {
        "ClusterId": "payment_cluster",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },
      "notification_route": {
        "ClusterId": "notification_cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "delivery_route": {
        "ClusterId": "delivery_cluster",
        "Match": { "Path": "/api/deliveries/{**catch-all}" }
      },
      "auth_swagger_route": {
        "ClusterId": "auth_cluster",
        "Match": { "Path": "/swagger/auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/auth" } ]
      },
      "restaurant_swagger_route": {
        "ClusterId": "restaurant_cluster",
        "Match": { "Path": "/swagger/restaurant/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/restaurant" } ]
      },
      "order_swagger_route": {
        "ClusterId": "order_cluster",
        "Match": { "Path": "/swagger/order/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/order" } ]
      },
      "payment_swagger_route": {
        "ClusterId": "payment_cluster",
        "Match": { "Path": "/swagger/payment/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/payment" } ]
      },
      "notification_swagger_route": {
        "ClusterId": "notification_cluster",
        "Match": { "Path": "/swagger/notification/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/notification" } ]
      },
      "delivery_swagger_route": {
        "ClusterId": "delivery_cluster",
        "Match": { "Path": "/swagger/delivery/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/swagger/delivery" } ]
      }
    },
    "Clusters": {
      "auth_cluster": {
        "Destinations": {
          "auth_destination": { "Address": "http://localhost:5001" }
        }
      },
      "restaurant_cluster": {
        "Destinations": {
          "restaurant_destination": { "Address": "http://localhost:5002" }
        }
      },
      "order_cluster": {
        "Destinations": {
          "order_destination": { "Address": "http://localhost:5003" }
        }
      },
      "payment_cluster": {
        "Destinations": {
          "payment_destination": { "Address": "http://localhost:5004" }
        }
      },
      "notification_cluster": {
        "Destinations": {
          "notification_destination": { "Address": "http://localhost:5005" }
        }
      },
      "delivery_cluster": {
        "Destinations": {
          "delivery_destination": { "Address": "http://localhost:5006" }
        }
      }
    }
  }
}
