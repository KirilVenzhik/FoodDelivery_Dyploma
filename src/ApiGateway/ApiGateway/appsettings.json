{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "food-delivery",
    "Audience": "food-delivery",
    "SecretKey": "SUPER_SECRET_DEVELOPMENT_KEY_123456789",
    "ExpirationMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": "Warning",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth_route": {
        "ClusterId": "auth_cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "restaurants_public_route": {
        "ClusterId": "restaurant_cluster",
        "Match": {
          "Path": "/api/restaurants/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "restaurants_protected_route": {
        "ClusterId": "restaurant_cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/restaurants/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "orders_route": {
        "ClusterId": "order_cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payments_route": {
        "ClusterId": "payment_cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },
      "notifications_route": {
        "ClusterId": "notification_cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "deliveries_route": {
        "ClusterId": "delivery_cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/deliveries/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth_cluster": {
        "Destinations": {
          "auth_destination": { "Address": "http://localhost:5001/" }
        }
      },
      "restaurant_cluster": {
        "Destinations": {
          "restaurant_destination": { "Address": "http://localhost:5002/" }
        }
      },
      "order_cluster": {
        "Destinations": {
          "order_destination": { "Address": "http://localhost:5003/" }
        }
      },
      "payment_cluster": {
        "Destinations": {
          "payment_destination": { "Address": "http://localhost:5004/" }
        }
      },
      "notification_cluster": {
        "Destinations": {
          "notification_destination": { "Address": "http://localhost:5005/" }
        }
      },
      "delivery_cluster": {
        "Destinations": {
          "delivery_destination": { "Address": "http://localhost:5006/" }
        }
      }
    }
  }
}
