@page "/owner/restaurants/{Id:guid}"
@attribute [Authorize(Roles = "RestaurantOwner")]
@inject RestaurantApiClient RestaurantApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_restaurant is null)
    {
        <MudAlert Severity="Severity.Error">Restaurant not found.</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h5" GutterBottom="true">@_restaurant.Name</MudText>

        <MudGrid>
            <MudItem xs="12" md="8">
                <MudCard Class="mb-4">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" GutterBottom="true">Details</MudText>
                        <MudTextField @bind-Value="_editName" Label="Name" Required="true" Class="mb-3" />
                        <MudTextField @bind-Value="_editDescription" Label="Description" Class="mb-3" />
                        <MudTextField @bind-Value="_editAddress" Label="Address" Required="true" />
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="SaveChanges" Disabled="_busy">
                            Save Changes
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudCard Class="mb-4">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" GutterBottom="true">Status</MudText>
                        <MudChip T="string" Color="@(_restaurant.Status == "Open" ? Color.Success : Color.Error)">
                            @_restaurant.Status
                        </MudChip>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Outlined"
                                   Color="@(_restaurant.Status == "Open" ? Color.Error : Color.Success)"
                                   OnClick="ToggleStatus" Disabled="_busy">
                            @(_restaurant.Status == "Open" ? "Close Restaurant" : "Open Restaurant")
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.h6">Menu Items</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="OpenAddItemDialog">
                Add Item
            </MudButton>
        </MudStack>

        <MudTable T="MenuItemResponse" Items="@_restaurant.MenuItems" Hover="true" Dense="true" Striped="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Description</MudTh>
                <MudTh>Price</MudTh>
                <MudTh>Available</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Description">@context.Description</MudTd>
                <MudTd DataLabel="Price">€@context.Price.ToString("0.00")</MudTd>
                <MudTd DataLabel="Available">
                    <MudChip T="string" Color="@(context.Available ? Color.Success : Color.Default)" Size="Size.Small">
                        @(context.Available ? "Yes" : "No")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => OpenEditItemDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => DeleteItem(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-4">No menu items yet. Add your first item!</MudText>
            </NoRecordsContent>
        </MudTable>
    }
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }

    private RestaurantResponse? _restaurant;
    private bool _loading = true;
    private bool _busy;
    private string _editName = "";
    private string _editDescription = "";
    private string _editAddress = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _restaurant = await RestaurantApi.GetRestaurantAsync(Id);
        if (_restaurant is not null)
        {
            _editName = _restaurant.Name;
            _editDescription = _restaurant.Description;
            _editAddress = _restaurant.Address;
        }
        else
        {
            Snackbar.Add("Restaurant not found.", Severity.Error);
        }
        _loading = false;
    }

    private async Task SaveChanges()
    {
        if (string.IsNullOrWhiteSpace(_editName) || string.IsNullOrWhiteSpace(_editAddress))
        {
            Snackbar.Add("Name and Address are required.", Severity.Warning);
            return;
        }
        _busy = true;
        var updated = await RestaurantApi.UpdateRestaurantAsync(Id, new CreateRestaurantRequest(_editName, _editDescription, _editAddress));
        _busy = false;
        if (updated is not null)
        {
            _restaurant = updated;
            Snackbar.Add("Changes saved.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to save changes.", Severity.Error);
        }
    }

    private async Task ToggleStatus()
    {
        if (_restaurant is null) return;
        _busy = true;
        if (_restaurant.Status == "Open")
            await RestaurantApi.CloseRestaurantAsync(Id);
        else
            await RestaurantApi.OpenRestaurantAsync(Id);
        await LoadAsync();
        _busy = false;
    }

    private async Task OpenAddItemDialog()
    {
        var dialogRef = await DialogService.ShowAsync<AddMenuItemDialog>("Add Menu Item");
        var result = await dialogRef.Result;
        if (result is { Canceled: false, Data: AddMenuItemRequest req })
        {
            var added = await RestaurantApi.AddMenuItemAsync(Id, req);
            if (added is not null)
            {
                _restaurant!.MenuItems.Add(added);
                Snackbar.Add("Menu item added.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to add menu item.", Severity.Error);
            }
        }
    }

    private async Task OpenEditItemDialog(MenuItemResponse item)
    {
        var parameters = new DialogParameters { ["Item"] = item };
        var dialogRef = await DialogService.ShowAsync<EditMenuItemDialog>("Edit Menu Item", parameters);
        var result = await dialogRef.Result;
        if (result is { Canceled: false, Data: UpdateMenuItemRequest req })
        {
            var updated = await RestaurantApi.UpdateMenuItemAsync(Id, item.Id, req);
            if (updated is not null)
            {
                var idx = _restaurant!.MenuItems.FindIndex(m => m.Id == item.Id);
                if (idx >= 0) _restaurant.MenuItems[idx] = updated;
                Snackbar.Add("Menu item updated.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to update menu item.", Severity.Error);
            }
        }
    }

    private async Task DeleteItem(MenuItemResponse item)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Confirm Delete",
            $"Delete \"{item.Name}\"?",
            yesText: "Delete", cancelText: "Cancel");
        if (confirm != true) return;

        var ok = await RestaurantApi.DeleteMenuItemAsync(Id, item.Id);
        if (ok)
        {
            _restaurant!.MenuItems.Remove(item);
            Snackbar.Add("Menu item deleted.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to delete menu item.", Severity.Error);
        }
    }
}
