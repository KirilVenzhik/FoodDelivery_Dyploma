@page "/owner/orders"
@attribute [Authorize(Roles = "RestaurantOwner")]
@inject OrderApiClient OrderApi
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudText Typo="Typo.h5" GutterBottom="true">Orders</MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_orders is null || _orders.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No orders yet.</MudAlert>
    }
    else
    {
        <MudTable T="OrderResponse" Items="_orders" Hover="true" Dense="true" Striped="true">
            <HeaderContent>
                <MudTh>Order ID</MudTh>
                <MudTh>Date</MudTh>
                <MudTh>Items</MudTh>
                <MudTh>Total</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Order ID">@context.Id.ToString()[..8]…</MudTd>
                <MudTd DataLabel="Date">@context.CreatedAt.ToLocalTime().ToString("g")</MudTd>
                <MudTd DataLabel="Items">@context.Items.Count</MudTd>
                <MudTd DataLabel="Total">€@context.TotalAmount.ToString("0.00")</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Color="@StatusColor(context.Status)" Size="Size.Small">
                        @context.Status
                    </MudChip>
                </MudTd>
                <MudTd>
                    @if (context.Status == "Paid")
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Info"
                                   OnClick="@(() => SetStatus(context, "InPreparation"))" Disabled="_busy">
                            Start Preparation
                        </MudButton>
                    }
                    else if (context.Status == "InPreparation")
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="@(() => SetStatus(context, "ReadyForDelivery"))" Disabled="_busy">
                            Ready for Delivery
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    private List<OrderResponse>? _orders;
    private bool _loading = true;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _orders = await OrderApi.GetOrdersAsync();
        if (_orders is null)
            Snackbar.Add("Failed to load orders.", Severity.Error);
        _loading = false;
    }

    private async Task SetStatus(OrderResponse order, string newStatus)
    {
        _busy = true;
        var updated = await OrderApi.ChangeStatusAsync(order.Id, newStatus);
        _busy = false;
        if (updated is not null)
        {
            var idx = _orders!.FindIndex(o => o.Id == order.Id);
            if (idx >= 0) _orders[idx] = updated;
            Snackbar.Add($"Status updated to {newStatus}.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to update status.", Severity.Error);
        }
    }

    private static Color StatusColor(string status) => status switch
    {
        "Paid" or "Completed" or "Delivered" => Color.Success,
        "PaymentFailed" or "Failed" => Color.Error,
        "PendingPayment" or "Pending" => Color.Warning,
        "InPreparation" or "InProgress" => Color.Info,
        "ReadyForDelivery" or "InDelivery" => Color.Primary,
        _ => Color.Default
    };
}
