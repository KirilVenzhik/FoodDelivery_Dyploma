<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Create Restaurant</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Name" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_description" Label="Description" Class="mb-3" />
        <MudTextField @bind-Value="_address" Label="Address" Required="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;

    private string _name = "";
    private string _description = "";
    private string _address = "";

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_address))
            return;
        MudDialog.Close(DialogResult.Ok(new CreateRestaurantRequest(_name, _description, _address)));
    }
}
