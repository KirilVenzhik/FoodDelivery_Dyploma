@page "/owner/restaurants"
@attribute [Authorize(Roles = "RestaurantOwner")]
@inject RestaurantApiClient RestaurantApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">My Restaurants</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog">
            Create Restaurant
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_restaurants is null || _restaurants.Count == 0)
    {
        <MudAlert Severity="Severity.Info">You have no restaurants yet. Create your first one!</MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var r in _restaurants)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard>
                        <MudCardContent>
                            <MudText Typo="Typo.h6">@r.Name</MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">@r.Address</MudText>
                            <MudChip T="string" Color="@(r.Status == "Open" ? Color.Success : Color.Error)" Size="Size.Small">
                                @r.Status
                            </MudChip>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Href="@($"/owner/restaurants/{r.Id}")"
                                       Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">
                                Manage
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<RestaurantSummaryResponse>? _restaurants;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _restaurants = await RestaurantApi.GetMyRestaurantsAsync();
        if (_restaurants is null)
            Snackbar.Add("Failed to load restaurants.", Severity.Error);
        _loading = false;
    }

    private async Task OpenCreateDialog()
    {
        var dialogRef = await DialogService.ShowAsync<CreateRestaurantDialog>("Create Restaurant");
        var result = await dialogRef.Result;
        if (result is { Canceled: false, Data: CreateRestaurantRequest req })
        {
            var created = await RestaurantApi.CreateRestaurantAsync(req);
            if (created is not null)
                Nav.NavigateTo($"/owner/restaurants/{created.Id}");
            else
                Snackbar.Add("Failed to create restaurant.", Severity.Error);
        }
    }
}
