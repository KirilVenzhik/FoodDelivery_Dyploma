@page "/customer/notifications"
@attribute [Authorize(Roles = "Customer")]
@inject NotificationApiClient NotificationApi
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudText Typo="Typo.h5" GutterBottom="true">Notifications</MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_notifications is null || _notifications.Count == 0)
    {
        <MudText>No notifications.</MudText>
    }
    else
    {
        @foreach (var n in _notifications)
        {
            <MudPaper Class="@($"pa-3 mb-2 {(n.IsRead ? "" : "mud-theme-dark")}")"
                      Elevation="@(n.IsRead ? 1 : 3)"
                      Style="cursor: pointer;"
                      @onclick="() => MarkRead(n)">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <div>
                        <MudText Typo="Typo.body1">@n.Message</MudText>
                        <MudText Typo="Typo.caption">@n.CreatedAt.ToLocalTime().ToString("g")</MudText>
                    </div>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudChip T="string" Color="Color.Info" Size="Size.Small">@n.Type</MudChip>
                        @if (!n.IsRead)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.FiberNew" Color="Color.Primary" Size="Size.Small" />
                        }
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private List<NotificationResponse>? _notifications;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _notifications = await NotificationApi.GetNotificationsAsync();
        if (_notifications is null)
            Snackbar.Add("Failed to load notifications.", Severity.Error);
        _loading = false;
    }

    private async Task MarkRead(NotificationResponse n)
    {
        if (n.IsRead) return;
        var updated = await NotificationApi.MarkReadAsync(n.Id);
        if (updated is not null)
        {
            var idx = _notifications!.IndexOf(n);
            if (idx >= 0)
                _notifications[idx] = updated;
        }
    }
}
