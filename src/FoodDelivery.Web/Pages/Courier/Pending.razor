@page "/courier/pending"
@attribute [Authorize(Roles = "Courier")]
@inject DeliveryApiClient Delivery
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudText Typo="Typo.h5" GutterBottom="true">Pending Deliveries</MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_items is null || _items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No pending deliveries at the moment.</MudAlert>
    }
    else
    {
        <MudTable Items="_items" Dense="true" Striped="true" Hover="true">
            <HeaderContent>
                <MudTh>Order ID</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.OrderId.ToString()[..8]…</MudTd>
                <MudTd>
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">@context.Status</MudChip>
                </MudTd>
                <MudTd>@context.CreatedAt.ToLocalTime().ToString("g")</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="@(() => AssignAsync(context.Id))" Disabled="_busy">
                        Assign to me
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    private List<DeliveryResponse>? _items;
    private bool _loading = true;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _items = await Delivery.GetPendingAsync();
        _loading = false;
    }

    private async Task AssignAsync(Guid id)
    {
        _busy = true;
        var result = await Delivery.AssignAsync(id);
        if (result is not null)
        {
            Snackbar.Add("Delivery assigned!", Severity.Success);
            _items = await Delivery.GetPendingAsync();
        }
        else
        {
            Snackbar.Add("Failed to assign delivery.", Severity.Error);
        }
        _busy = false;
    }
}
