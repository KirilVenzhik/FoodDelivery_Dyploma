@page "/courier/deliveries"
@attribute [Authorize(Roles = "Courier")]
@inject DeliveryApiClient Delivery
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudText Typo="Typo.h5" GutterBottom="true">My Deliveries</MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_items is null || _items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No deliveries assigned to you yet.</MudAlert>
    }
    else
    {
        <MudTable Items="_items" Dense="true" Striped="true" Hover="true">
            <HeaderContent>
                <MudTh>Order ID</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Updated</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudLink Href="@($"/courier/deliveries/{context.Id}")">
                        @context.OrderId.ToString()[..8]…
                    </MudLink>
                </MudTd>
                <MudTd>
                    <MudChip T="string" Color="@StatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
                </MudTd>
                <MudTd>@context.UpdatedAt.ToLocalTime().ToString("g")</MudTd>
                <MudTd>
                    @if (context.Status == "Assigned")
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Info"
                                   OnClick="@(() => PickupAsync(context.Id))" Disabled="_busy">
                            Pick Up
                        </MudButton>
                    }
                    else if (context.Status == "InProgress")
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                   OnClick="@(() => CompleteAsync(context.Id))" Disabled="_busy">
                            Complete
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    private List<DeliveryResponse>? _items;
    private bool _loading = true;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _items = await Delivery.GetMyDeliveriesAsync();
        _loading = false;
    }

    private async Task PickupAsync(Guid id)
    {
        _busy = true;
        var result = await Delivery.PickupAsync(id);
        if (result is not null)
        {
            Snackbar.Add("Delivery picked up!", Severity.Success);
            _items = await Delivery.GetMyDeliveriesAsync();
        }
        else
        {
            Snackbar.Add("Failed to pick up delivery.", Severity.Error);
        }
        _busy = false;
    }

    private async Task CompleteAsync(Guid id)
    {
        _busy = true;
        var result = await Delivery.CompleteAsync(id);
        if (result is not null)
        {
            Snackbar.Add("Delivery completed!", Severity.Success);
            _items = await Delivery.GetMyDeliveriesAsync();
        }
        else
        {
            Snackbar.Add("Failed to complete delivery.", Severity.Error);
        }
        _busy = false;
    }

    private static Color StatusColor(string status) => status switch
    {
        "Assigned"   => Color.Warning,
        "InProgress" => Color.Info,
        "Delivered"  => Color.Success,
        _            => Color.Default
    };
}
