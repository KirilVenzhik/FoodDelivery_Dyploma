@page "/"

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Class="pa-8" Elevation="2">
        <MudText Typo="Typo.h4" GutterBottom="true">FoodDelivery</MudText>
        <MudText Typo="Typo.body1" Class="mb-6">
            Order from restaurants, manage menus, or deliver — a microservices food-delivery platform.
        </MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary">Login</MudButton>
            <MudButton Href="/register" Variant="Variant.Outlined" Color="Color.Primary">Register</MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>
