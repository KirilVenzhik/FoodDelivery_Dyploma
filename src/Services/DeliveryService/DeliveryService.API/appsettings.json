{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5437;Database=delivery_db;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/delivery-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Username": "guest",
    "Password": "guest",
    "ExchangeName": "food-delivery.events"
  },
  "Jwt": {
    "Issuer": "food-delivery",
    "Audience": "food-delivery",
    "SecretKey": "",
    "ExpirationMinutes": 60
  },
  "AllowedHosts": "*"
}
