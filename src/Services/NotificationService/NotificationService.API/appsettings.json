{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5438;Database=notification_db;Username=postgres;Password=postgres"
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Username": "guest",
    "Password": "guest",
