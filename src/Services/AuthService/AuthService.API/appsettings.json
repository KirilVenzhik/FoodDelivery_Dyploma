{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=auth-db;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "food-delivery",
    "Audience": "food-delivery",
    "SecretKey": "SUPER_SECRET_DEVELOPMENT_KEY_123456789",
    "ExpirationMinutes": 60
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://seq:80" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Username": "guest",
    "Password": "guest",
    "ExchangeName": "food-delivery.events"
  },
  "AllowedHosts": "*"
}
